# Copy to .env.local. Placeholders only. NEVER put the API token here: VITE_* values are embedded
# in the public JavaScript bundle. The token is typed into the UI at runtime instead.

# Leave empty in development: requests go to this dev server, which proxies /api and /health to the backend.
# For a production build served from another origin, set the backend URL (and add that origin to CORS_ORIGINS in the backend .env).
VITE_API_BASE_URL=

# Optional: where the Vite dev server forwards API calls.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
