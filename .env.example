# Copy to .env. Never share or commit this file.

# --- Telegram alerts (easiest): message @BotFather -> /newbot -> copy token.
# Send any message to your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates to find chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email alerts (optional). For Gmail use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Dashboard password (set this if the dashboard is reachable from the internet)
DASHBOARD_PASSWORD=

# --- Dead-man's switch (optional): free check URL from healthchecks.io. Pinged after every good cycle.
HEALTHCHECKS_URL=

# --- CoinSwitch (optional)
# CoinSwitch PRO API keys (optional; hex strings from CoinSwitch PRO > Profile > API Trading). Needed even for market data.
# WARNING: CoinSwitch's docs describe no read-only key scope, so treat these keys as able to place orders and withdraw
# nothing here ever does (this project is paper-trading only, enforced by tests), but never share or commit them.
COINSWITCH_API_KEY=
COINSWITCH_SECRET_KEY=
COINSWITCH_EXCHANGE=coinswitchx

# --- If api.binance.com is blocked from your server, try: https://data-api.binance.vision
BINANCE_BASE=https://api.binance.com

# --- API. Set a long random value before exposing the API beyond your own machine.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
CORS_ORIGINS=http://localhost:5173
API_RATE_LIMIT_PER_MIN=120
